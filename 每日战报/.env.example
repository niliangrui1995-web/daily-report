# VCP Hunter env template (copy to .env and fill in real values)
TDX_ROOT=D:\HT
ANTIGRAVITY_BASE_URL=http://127.0.0.1:8045
ANTIGRAVITY_API_KEY=your-api-key-here
PRO_OPUS_BASE_URL=http://127.0.0.1:8317/v1
PRO_OPUS_API_KEY=your-pro-opus-api-key-or-leave-empty
GEMINI_SEARCH_API_KEYS=key1,key2,key3,key4,key5
GEMINI_SEARCH_MODEL=gemini-2.5-flash
AUDIT_MODEL=claude-sonnet-4-6
AUDIT_FALLBACK_BASE_URL=https://cldapi.com
AUDIT_FALLBACK_API_KEY=your-audit-fallback-api-key
OPENAI_COMPAT_MAX_TOKENS=64000
GEMINI_PRO_API_KEY=your-gemini-pro-api-key-or-leave-empty
TAVILY_API_KEY=your-tavily-key-here
GROK_API_KEY=your-xai-grok-api-key-here
GROK_MODEL=grok-4.3
GROK_REASONING_EFFORT=none
GROK_MAX_OUTPUT_TOKENS=4096
GROK_NATIVE_REASONING_EFFORT=none
GROK_NATIVE_MAX_OUTPUT_TOKENS=4096
GROK_NATIVE_ENABLE_X_SEARCH=false
INSECURE_TLS_ALLOWLIST=
EMAIL_ADDRESS=your-email@qq.com
EMAIL_PASSWORD=your-smtp-authorization-code
RECEIVER_EMAIL=receiver1@gmail.com,receiver2@163.com
